                                    <constraint firstAttribute="height" constant="66" id="img-height"/>
                                    <constraint firstItem="badge-image" firstAttribute="centerX" secondItem="image-container" secondAttribute="centerX" id="img-center-x"/>
                                    <constraint firstItem="badge-image" firstAttribute="centerY" secondItem="image-container" secondAttribute="centerY" id="img-center-y"/>
                                </constraints>
