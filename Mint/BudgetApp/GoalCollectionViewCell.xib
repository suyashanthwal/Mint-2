<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="24765" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24743"/>
        <capability name="collection view cell content view" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" reuseIdentifier="GoalCollectionViewCell" id="g1" customClass="GoalCollectionViewCell" customModule="BudgetApp" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="353" height="86"/>
            <autoresizingMask key="autoresizingMask"/>
            <collectionViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" contentMode="center" id="g2">
                <rect key="frame" x="0.0" y="0.0" width="353" height="86"/>
                <autoresizingMask key="autoresizingMask"/>
                <subviews>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="card">
                        <rect key="frame" x="0.0" y="0.0" width="353" height="86"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="icon">
                                <rect key="frame" x="18" y="25" width="36" height="36"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="36" id="i1"/>
                                    <constraint firstAttribute="height" constant="36" id="i2"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Headphones" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                                <rect key="frame" x="72" y="32" width="130" height="22"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="18"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="right" text="₹700/month" textAlignment="right" lineBreakMode="tailTruncation" adjustsFontSizeToFit="YES" minimumScaleFactor="0.75" translatesAutoresizingMaskIntoConstraints="NO" id="amount">
                                <rect key="frame" x="210" y="32" width="125" height="22"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="18"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <constraints>
                            <constraint firstItem="icon" firstAttribute="leading" secondItem="card" secondAttribute="leading" constant="18" id="c1"/>
                            <constraint firstItem="icon" firstAttribute="centerY" secondItem="card" secondAttribute="centerY" id="c2"/>
                            <constraint firstItem="title" firstAttribute="leading" secondItem="icon" secondAttribute="trailing" constant="18" id="c3"/>
                            <constraint firstItem="title" firstAttribute="centerY" secondItem="card" secondAttribute="centerY" id="c4"/>
                            <constraint firstItem="amount" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="title" secondAttribute="trailing" constant="12" id="c5"/>
                            <constraint firstAttribute="trailing" secondItem="amount" secondAttribute="trailing" constant="18" id="c6"/>
                            <constraint firstItem="amount" firstAttribute="centerY" secondItem="card" secondAttribute="centerY" id="c7"/>
                        </constraints>
                    </view>
                </subviews>
                <constraints>
                    <constraint firstItem="card" firstAttribute="top" secondItem="g2" secondAttribute="top" id="r1"/>
                    <constraint firstItem="card" firstAttribute="leading" secondItem="g2" secondAttribute="leading" id="r2"/>
                    <constraint firstAttribute="trailing" secondItem="card" secondAttribute="trailing" id="r3"/>
                    <constraint firstAttribute="bottom" secondItem="card" secondAttribute="bottom" id="r4"/>
                </constraints>
            </collectionViewCellContentView>
            <connections>
                <outlet property="amountLabel" destination="amount" id="o1"/>
                <outlet property="cardView" destination="card" id="o2"/>
                <outlet property="iconImageView" destination="icon" id="o3"/>
                <outlet property="titleLabel" destination="title" id="o4"/>
            </connections>
            <point key="canvasLocation" x="120" y="80"/>
        </collectionViewCell>
    </objects>
</document>
